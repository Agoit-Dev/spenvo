rules_version = '2';

// M7 Slice A1 — Firebase Storage rules for avatar uploads (see CHANGELOG.md).
// Owner-only read+write (no broader read yet — MiembroCard shows no avatars
// today), image/* content-type allowlist, 5MB size limit, fixed
// avatars/{uid}/avatar.jpg path (overwrite on re-upload).

service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
