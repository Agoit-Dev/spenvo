rules_version = '2';

// BORRADOR M0 — deny-by-default con roles server-side.
// NO DESPLEGAR en producción hasta M3 (firestore-rules-audit + tests con Emulator).
// editedBy/editedAt se setean aquí con request.auth.uid / request.time (M5).

function isSignedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return request.auth.uid == uid;
}

// El usuario tiene rol >= el pedido sobre un plan.
// roles: owner(3) > admin(2) > editor(1) > viewer(0)
function roleOf(planId) {
  return get(/databases/$(database)/documents/acceso_plan_financiero/$(request.auth.uid)_$(planId))
    .data.rol;
}

function hasRole(planId, minRole) {
  if (!isSignedIn()) return false;
  let rol = roleOf(planId);
  return rol == 'owner' || rol == 'admin' && minRole <= 2 ||
    rol == 'editor' && minRole <= 1 || rol == 'viewer' && minRole <= 0;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- usuarios ----------
    match /usuarios/{usuarioId} {
      allow read: if isOwner(usuarioId);
      allow create: if isOwner(usuarioId)
        && request.resource.data.uid == usuarioId;
      allow update: if isOwner(usuarioId);
      allow delete: if false;
    }

    // ---------- planes_financieros ----------
    match /planes_financieros/{planId} {
      allow read: if hasRole(planId, 0);
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasRole(planId, 1) // editor+
        && request.resource.data.editedBy == request.auth.uid; // M5
      allow delete: if false; // soft-delete via update
    }

    // ---------- acceso_plan_financiero (pivote N:M) ----------
    match /acceso_plan_financiero/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && docId == request.auth.uid + '_' + request.resource.data.planId
        || hasRole(request.resource.data.planId, 2); // admin invita
      allow update: if hasRole(resource.data.planId, 2); // admin gestiona roles
      allow delete: if false;
    }

    // ---------- categorias ----------
    match /categorias/{categoriaId} {
      allow read: if hasRole(request.resource.data.planId, 0);
      allow create: if hasRole(request.resource.data.planId, 1); // editor+
      allow update: if hasRole(resource.data.planId, 1)
        && request.resource.data.editedBy == request.auth.uid; // M5
      allow delete: if false;
    }

    // ---------- gastos / ingresos ----------
    match /gastos/{gastoId} {
      allow read: if hasRole(resource.data.planId, 0);
      allow create: if hasRole(request.resource.data.planId, 1);
      allow update: if hasRole(resource.data.planId, 1)
        && request.resource.data.editedBy == request.auth.uid; // M5
      allow delete: if false;
    }

    match /ingresos/{ingresoId} {
      allow read: if hasRole(resource.data.planId, 0);
      allow create: if hasRole(request.resource.data.planId, 1);
      allow update: if hasRole(resource.data.planId, 1)
        && request.resource.data.editedBy == request.auth.uid; // M5
      allow delete: if false;
    }
  }
}